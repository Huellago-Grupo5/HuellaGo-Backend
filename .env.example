# Copiar a .env y reemplazar los valores privados. Spring Boot NO carga este archivo automáticamente.
# OBLIGATORIAS para iniciar Java: contraseña del rol PostgreSQL y secreto JWT Base64 (32+ bytes).
HUELLAGO_DB_PASSWORD=
HUELLAGO_JWT_SECRET=

# OPCIONALES: destino y rol PostgreSQL. Valores de ejemplo para Docker Compose.
# Para PostgreSQL nativo en 5432, cambiar el puerto y el rol según la instalación.
HUELLAGO_DB_URL=jdbc:postgresql://localhost:55432/huellagodb_hu29_test
HUELLAGO_DB_USERNAME=huellago_local
HUELLAGO_COMPOSE_PG_PORT=55432
HUELLAGO_COMPOSE_OLLAMA_PORT=11435

# OPCIONALES: ejecución local. Ollama ya está habilitado en application.properties.
# El modelo validado debe seguir siendo qwen3:4b-instruct.
HUELLAGO_OLLAMA_ENABLED=true
HUELLAGO_OLLAMA_BASE_URL=http://localhost:11435
HUELLAGO_OLLAMA_CONNECT_TIMEOUT=PT3S
HUELLAGO_OLLAMA_READ_TIMEOUT=PT120S
HUELLAGO_OLLAMA_MAX_RESPONSE_BYTES=65536
HUELLAGO_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
HUELLAGO_SWAGGER_ENABLED=true
HUELLAGO_CIERRE_COLECTIVO_ENABLED=true

# OPCIONALES: Open-Meteo funciona sin clave. Geoapify requiere clave solo al activarlo.
HUELLAGO_OPEN_METEO_ENABLED=true
HUELLAGO_OPEN_METEO_URL=https://air-quality-api.open-meteo.com/v1/air-quality
HUELLAGO_GEOAPIFY_ENABLED=false
HUELLAGO_GEOAPIFY_API_KEY=
HUELLAGO_GEOAPIFY_DAILY_LIMIT=1000
HUELLAGO_GEOAPIFY_READ_TIMEOUT_SECONDS=8
HUELLAGO_AMBIENTE_CONNECT_TIMEOUT_SECONDS=3
HUELLAGO_AMBIENTE_READ_TIMEOUT_SECONDS=8

# OPCIONALES: recuperación por Gmail SMTP. Requiere todos los valores al activarla.
# Usar una contraseña de aplicación de Google, nunca la contraseña principal.
HUELLAGO_RECOVERY_ENABLED=false
HUELLAGO_RECOVERY_FROM=
HUELLAGO_RECOVERY_RESET_URL=http://localhost:4200/ruta-real-de-restablecimiento
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
HUELLAGO_SMTP_AUTH=true
HUELLAGO_SMTP_STARTTLS_ENABLE=true
HUELLAGO_SMTP_STARTTLS_REQUIRED=true

# OPCIONALES: límites de recuperación (valores predeterminados del código).
HUELLAGO_RECOVERY_RATE_WINDOW_SECONDS=900
HUELLAGO_RECOVERY_RATE_COOLDOWN_SECONDS=60
HUELLAGO_RECOVERY_RATE_ACCOUNT_LIMIT=3
HUELLAGO_RECOVERY_RATE_IP_LIMIT=20
HUELLAGO_RECOVERY_RATE_MAX_ENTRIES=10000
